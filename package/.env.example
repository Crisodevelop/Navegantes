# Neon Postgres (Vercel → Storage → Neon). Vercel las crea automáticamente.
DATABASE_URL="postgresql://user:pass@host-pooler/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:pass@host/db?sslmode=require"

# Contraseña para entrar a /admin
ADMIN_PASSWORD="cambia-esto"
# Cadena aleatoria larga para firmar la sesión (openssl rand -hex 32)
ADMIN_SECRET="cambia-esto-por-una-cadena-larga"
